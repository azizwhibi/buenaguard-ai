# BuenaGuard AI Environment Configuration

# Mode: MOCK (Zero-Billing offline simulation) or LIVE (Real Drive/Sheets/AI Studio)
WORKSPACE_MODE=MOCK

# Google AI Studio API Key (Leave blank to read from geminiapikey.txt or mock fallback)
GEMINI_API_KEY=

# Gemini Model Designation (gemini-2.5-flash default, fallback to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth Credentials file path (Default: credentials.json)
GOOGLE_OAUTH_CREDENTIALS=credentials.json

# OAuth Token Storage file path (Default: token.json)
GOOGLE_OAUTH_TOKEN=token.json

# Web Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Audit Storage
AUDIT_DB_PATH=audit_logs.db
